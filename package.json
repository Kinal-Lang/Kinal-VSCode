{
  "name": "kinal",
  "displayName": "Kinal",
  "description": "Language support for Kinal (.kn, .kinal, .knproj)",
  "version": "0.5.0",
  "publisher": "kinal",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kinal-Lang/Kinal-VSCode.git"
  },
  "homepage": "https://kinal.org",
  "bugs": {
    "url": "https://github.com/Kinal-Lang/Kinal-VSCode/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "keywords": [
    "kinal",
    "knproj",
    "language",
    "compiler",
    "lsp",
    "formatter",
    "llvm",
    "vm",
    "ffi"
  ],
  "galleryBanner": {
    "color": "#11161d",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:kinal",
    "onLanguage:knproj",
    "onCommand:kinal.runFile",
    "onCommand:kinal.newProjectFile",
    "onCommand:editor.action.formatDocument"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "kinal",
        "aliases": [
          "Kinal",
          "kinal"
        ],
        "extensions": [
          ".kn",
          ".kinal"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "knproj",
        "aliases": [
          "Kinal Project",
          "knproj"
        ],
        "extensions": [
          ".knproj"
        ],
        "configuration": "./knproj-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kinal",
        "scopeName": "source.kinal",
        "path": "./syntaxes/kinal.tmLanguage.json"
      },
      {
        "language": "knproj",
        "scopeName": "source.knproj",
        "path": "./syntaxes/knproj.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "kinal.runFile",
        "title": "Kinal: Compile and Run"
      },
      {
        "command": "kinal.newProjectFile",
        "title": "Kinal: New Project File"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "kinal.runFile",
          "when": "resourceExtname == .kn || resourceExtname == .kinal",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "kinal.newProjectFile",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Kinal",
      "properties": {
        "kinal.path": {
          "type": "string",
          "default": "kinal",
          "description": "Path to kinal compiler executable."
        },
        "kinal.defaultLinker": {
          "type": "string",
          "enum": [
            "lld",
            "zig",
            "msvc"
          ],
          "default": "lld",
          "description": "Default linker passed to --linker."
        },
        "kinal.linkerPath": {
          "type": "string",
          "default": "",
          "description": "Optional explicit linker executable path passed to --linker-path."
        },
        "kinal.serverPath": {
          "type": "string",
          "default": "kinal-lsp-server",
          "description": "Path to Kinal LSP server executable."
        },
        "kinal.compilerLanguage": {
          "type": "string",
          "enum": [
            "en",
            "auto",
            "zh"
          ],
          "default": "auto",
          "description": "Diagnostic language used by the kinal compiler when compiling from the editor."
        },
        "kinal.diagnosticsLanguage": {
          "type": "string",
          "enum": [
            "en",
            "auto",
            "zh"
          ],
          "default": "en",
          "description": "Diagnostics language used by the Kinal language server (LSP)."
        },
        "kinal.localeFile": {
          "type": "string",
          "default": "",
          "description": "Optional locale JSON file for diagnostics (mapped by diagnostic code)."
        }
      }
    },
    "configurationDefaults": {
      "[kinal]": {
        "editor.defaultFormatter": "kinal.kinal"
      }
    }
  },
  "scripts": {
    "compile": "python build.py compile",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "deps": "python build.py deps",
    "build": "python build.py compile",
    "test": "python build.py test",
    "package": "python build.py package",
    "clean": "python build.py clean"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.25.3",
    "typescript": "^5.5.4"
  }
}
